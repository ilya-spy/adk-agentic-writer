# Example environment configuration
# Copy this file to .env and update with your values

# Backend Configuration
PYTHONUNBUFFERED=1

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# =============================================================================
# OPTION 1: Google AI Studio API Key (Recommended for development)
# =============================================================================
# Get your API key at: https://aistudio.google.com/app/apikey
# The API key is automatically bound to your Google AI project.
# No additional project configuration needed.
# =============================================================================
GOOGLE_API_KEY=YOUR_API_KEY_HERE

# =============================================================================
# OPTION 2: Vertex AI (Google Cloud) - For production/enterprise
# =============================================================================
# Requires Google Cloud project with Vertex AI enabled.
# Authenticate via: gcloud auth application-default login
# =============================================================================
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# =============================================================================
# Model Configuration
# =============================================================================
# Gemini model to use (default: gemini-2.5-flash-lite)
# Available: gemini-2.5-flash-lite, gemini-2.0-flash, gemini-1.5-flash
# GEMINI_MODEL=gemini-2.5-flash-lite
