# Example environment configuration
# Copy this file to .env and update with your values

# Backend Configuration
PYTHONUNBUFFERED=1

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# =============================================================================
# Google API Key (REQUIRED for Gemini Team)
# =============================================================================
# Get your API key at: https://aistudio.google.com/app/apikey
#
# Steps:
# 1. Go to Google AI Studio (https://aistudio.google.com)
# 2. Sign in with your Google account
# 3. Click "Get API Key" or go to API Keys section
# 4. Create a new API key or use existing one
# 5. Copy the key and paste below (replace YOUR_API_KEY)
#
# Without this key, Gemini team will fall back to static templates.
# =============================================================================
GOOGLE_API_KEY=YOUR_API_KEY_HERE

# Optional: Specify Gemini model (default: gemini-2.5-flash-lite)
# Available models: gemini-2.5-flash-lite, gemini-2.0-flash, gemini-1.5-flash
# GEMINI_MODEL=gemini-2.5-flash-lite
